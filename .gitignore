# ---- Blender auto-backups ----
*.blend1

# ---- Zipped QA runs (screenshots live in the run folders; archives stay local) ----
/Docs/QA/*.zip

# ---- Unity editor caches created at runtime ----
/Game/DataStore/

# ---- Promo film: raw footage, renders, audio and tool envs stay local (scripts, SRT and manifests are tracked) ----
