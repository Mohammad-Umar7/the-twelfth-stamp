*.aab

# ---- Tooling caches ----
/Tools/.venv/
/Tools/**/__pycache__/
/Audio/.cache/
/Audio/_work/
node_modules/
.hyperframes/
.media/

# ---- Never commit secrets or browser data ----
*.env
.env*
*.pem
*.key
cookies*
*BrowserData*

# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- QA screenshots: reports are committed; only a few key frames of the final run ----
/Docs/QA/**/*.png
!/Docs/QA/run8/01_menu.png
